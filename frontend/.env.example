# Transport selection for the frontend data layer.
#
#   VITE_API_MODE=mock   answer every call from the local mock transport (default,
#                        no backend needed)
#   VITE_API_MODE=live   call a civic API at VITE_API_BASE_URL
#
# In `live` mode, if the backend is unreachable (network error, timeout or a 5xx)
# the same call transparently falls back to the mock transport, so the demo keeps
# working with a partial-data banner instead of an error screen.
#
# Both transports emit identical shapes (see docs/API_CONTRACT.md), so nothing in
# src/components changes when the backend arrives.
#
# Convenience scripts: `npm run dev:mock` (.env.mock) and `npm run dev:live`
# (.env.live), so the two transports never have to be toggled by hand.

VITE_API_MODE=mock

# Only read when VITE_API_MODE=live
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_TIMEOUT_MS=12000
